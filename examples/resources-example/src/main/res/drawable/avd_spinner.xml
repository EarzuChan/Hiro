<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="72dp"
            android:height="72dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group
                android:name="spinner"
                android:pivotX="12"
                android:pivotY="12">
                <path
                    android:name="square"
                    android:fillColor="#FF42A5F5"
                    android:pathData="M6,6h12v12h-12z" />
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M11,4h2v6h-2z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="spinner">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="180" />
        </aapt:attr>
    </target>
    <target android:name="square">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="900"
                android:propertyName="fillColor"
                android:valueFrom="#FF42A5F5"
                android:valueTo="#FFFF7043"
                android:valueType="colorType" />
        </aapt:attr>
    </target>
</animated-vector>
